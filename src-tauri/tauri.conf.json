{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SQL Vault",
  "version": "1.0.0",
  "identifier": "cleberlima.sqlvaul",
  "build": {
    "devUrl": "http://localhost:8756",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../index.php": "index.php",
      "../app": "app",
      "../routes": "routes",
      "../config": "config",
      "../assets": "assets",
      "php": "php"
    }
  }
}